{
  "name": "rikai-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "rikai の開発用ワークスペース（TypeScript のソースとビルド）。配布物は、ビルドして skills/rikai/ に置く",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "dev": "vite",
    "build:server": "tsx scripts/build.ts",
    "build:web": "vite build",
    "build": "pnpm run build:server && pnpm run build:web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@playwright/test": "^1.65.1",
    "@tanstack/react-query": "^5.108.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.18",
    "esbuild": "^0.28.2",
    "hono": "^4.13.19",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
