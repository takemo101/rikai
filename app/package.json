{
  "name": "rikai-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "rikai の開発用ワークスペース（TypeScript のソースとビルド）。配布物は、ビルドして skills/rikai/ に置く",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "build": "tsx scripts/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "hono": "^4.13.19",
    "marked": "^18.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
