{
  "name": "rikai",
  "version": "0.30.2",
  "private": true,
  "description": "資料にコメントして「AI に送る」を押すと、AI が返信と資料の修正（版）で答える。理解できるまで回すスキル",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "test": "pnpm --dir app test",
    "typecheck": "pnpm --dir app typecheck",
    "lint": "pnpm --dir app lint",
    "format": "pnpm --dir app format",
    "build": "pnpm --dir app build",
    "test:e2e": "pnpm --dir app test:e2e"
  }
}
